# Pacman Dongle Adapter Shield - Default Kconfig

config ZMK_DISPLAY
  default y

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
  default y

config DISPLAY
  default y

config LVGL
  default y

config SPI
  default y

config GPIO
  default y

config ZMK_DONGLE_PACMAN
  default y

config ZMK_DONGLE_ACTION
  default y
